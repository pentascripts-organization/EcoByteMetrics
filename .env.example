#Dados ficticios
#Variaveis de ambiente  do database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=greener_user
POSTGRES_PASSWORD=greener_pass
POSTGRES_DATABASE=greener_db
POSTGRES_PORT_CONTEINER=5433
# Opcional: nome diferente para manter outro banco local intacto
# POSTGRES_CONTAINER_NAME=ecobytemetrics-dashboardsp2-postgres

# Usuarios iniciais (obrigatorios para a primeira inicializacao do PostgreSQL).
# Defina senhas fortes; o DML.sql gera e armazena hashes Bcrypt.
ADMIN_SEED_NAME=Administrador
ADMIN_SEED_EMAIL=admin@ecobytemetrics.local
ADMIN_SEED_PASSWORD=SUBSTITUA_POR_SENHA_FORTE_ADMIN
USER_SEED_NAME=Usuario
USER_SEED_EMAIL=user@ecobytemetrics.local
USER_SEED_PASSWORD=SUBSTITUA_POR_SENHA_FORTE_USER

#Varieveis de ambiente do backend
PORT=3000
PORT_CONTEINER=3000
API_METRIC="https://metrics.unilaunch.org"
API_CARBON="https://carbon.unilaunch.org"
JWT_SECRET=sua_chave_secreta_jwt
JWT_EXPIRES_IN=1h

#Variaveis do ambiente do frontend
FRONT_PORT=5173
FRONTEND_INTERNAL_PORT=80
