# Execução local do backend; use as credenciais reais do seu PostgreSQL.
PORT=3001
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=greener_user
POSTGRES_PASSWORD=defina_a_senha_do_banco
POSTGRES_DATABASE=greener_db
API_METRIC=https://metrics.unilaunch.org
API_CARBON=https://carbon.unilaunch.org
JWT_SECRET=defina_um_segredo_proprio
JWT_EXPIRES_IN=1h
