{
  "name": "backend",
  "version": "1.0.0",
  "description": "Servidor backend modular com Node.js, Express e TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test tests/*.test.ts",
    "test:auth": "tsx --test tests/auth.test.ts",
    "test:auth:postgres": "tsx --test tests/integration/auth.postgres.test.ts",
    "test:worker:postgres": "tsx --test tests/integration/carbon.postgres.test.ts",
    "test:history:postgres": "tsx --test tests/integration/monitoring.postgres.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.4",
    "typescript": "^5.9.2"
  }
}
