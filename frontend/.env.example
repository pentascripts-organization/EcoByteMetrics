# Endereço público do backend. /backend usa o proxy do Vite ou do Nginx.
VITE_BACKEND_URL=/backend
# Somente desenvolvimento local; acessado pelo servidor Vite.
BACKEND_PROXY_TARGET=http://127.0.0.1:3000
# npm run dev inicia o backend local existente. false permite iniciá-lo separadamente.
AUTO_START_BACKEND=true
